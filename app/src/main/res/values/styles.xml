<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="green">#16A34A</color>
    <color name="green_dark">#15803D</color>
    <color name="green_light">#E7F5EC</color>
    <color name="bg">#F3F6F4</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="BtnGreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/btn_green</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnLight" parent="BtnGreen">
        <item name="android:background">@drawable/btn_light</item>
        <item name="android:textColor">#166534</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:padding">11dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#1F2937</item>
    </style>

    <style name="TotalNum">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#16A34A</item>
        <item name="android:text">0</item>
    </style>

    <style name="TotalLbl">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#6B7280</item>
    </style>
</resources>
